# ============================================
# Variáveis de Ambiente - Lakehouse
# ============================================
# Copie este arquivo para .env e ajuste conforme necessário

# UID/GID para Airflow e Superset
# Execute: echo "AIRFLOW_UID=$(id -u)" >> .env
# IMPORTANTE: Airflow requer GID=0 mesmo com UID diferente
AIRFLOW_UID=1000
AIRFLOW_GID=0

# ============================================
# Segurança - Secret Key do Superset
# ============================================
# IMPORTANTE: Gere sua própria chave Fernet e NUNCA versione em repositórios!
# Execute: openssl rand -hex 32
# Depois adicione ao seu arquivo .env local (NÃO versione o .env!)
SUPERSET_SECRET_KEY=

# ============================================
# Segurança - Senha Admin do Superset
# ============================================
# Configure a senha do admin (NÃO versione em repositórios!)
SUPERSET_ADMIN_PASSWORD=

# ============================================
# Credenciais Airflow
# ============================================
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=

# ============================================
# Credenciais PostgreSQL
# ============================================
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=airflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ============================================
# Configurações MinIO
# ============================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
