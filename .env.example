# ============================================
# Variáveis de Ambiente - Lakehouse
# ============================================
# Copie este arquivo para .env e ajuste conforme necessário

# UID/GID para Airflow e Superset (evita problemas de permissão)
# Execute: echo "AIRFLOW_UID=$(id -u)" >> .env
AIRFLOW_UID=1000
AIRFLOW_GID=1000
SUPERSET_UID=1000
SUPERSET_GID=1000

# Secret Key do Superset (gere uma chave segura em produção)
SUPERSET_SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32

# Configurações do Banco de Dados
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=lakehouse
POSTGRES_PASSWORD=lakehouse123
POSTGRES_DB=lakehouse

# Configurações MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# Configurações Airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false

# Configurações do Projeto
PYTHONUNBUFFERED=1
ENVIRONMENT=development

# ============================================
# Segurança - Credenciais (substitua em produção!)
# ============================================
AIRFLOW_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_PASSWORD=admin
MINIO_ROOT_PASSWORD=minioadmin123

# ============================================
# Segurança - Fernet Key (Airflow)
# ============================================
# IMPORTANTE: Gere sua própria chave Fernet e NUNCA versione em repositórios!
# Execute: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Depois adicione ao seu arquivo .env local (NÃO versione o .env!)
AIRFLOW__CORE__FERNET_KEY=
